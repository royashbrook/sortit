{
  // Sort It on its own origin, served as Cloudflare Workers static assets, the same
  // pattern as craftrush / scoopaloo / quarry: its own hostname so the game deploys
  // itself when it changes, and its traffic stays out of the content site's analytics.
  //
  // SvelteKit static build output. npm run build writes build/, the deploy publishes it.
  "name": "sortit",
  // not a secret, and inlining it lets CI deploy without an account picker
  "account_id": "b13c1cf2483bdad430b91ae25126e984",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./build"
  },
  // custom_domain provisions the DNS record and the cert, so the hostname is
  // declared here rather than clicked into a dashboard and forgotten.
  "routes": [
    { "pattern": "sortit.royashbrook.com", "custom_domain": true }
  ]
}
